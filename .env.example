# Pooled Postgres connection used by the app at runtime.
# Neon: use the -pooler host and append ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Unpooled connection used by `prisma migrate` (Neon's pooler cannot run DDL).
# For a plain Postgres server this is the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 32+ random bytes. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Vercel Blob — product images and COA uploads from the admin dashboard.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------- email
# Order emails are sent over SMTP from the store's own mailbox. Host, port and
# username already default to the BioPlus mailbox in src/lib/email.ts, so in
# most deployments SMTP_PASSWORD is the only variable that has to be set.
SMTP_PASSWORD=""

# Only needed to point at a different mailbox or server.
# SMTP_HOST="de9000-r.dnsiaas.com"
# SMTP_PORT="465"          # 465 = implicit TLS, 587 = STARTTLS
# SMTP_SECURE="true"       # defaults to true on port 465
# SMTP_USER="alex@biopluslabs.co.uk"

# The From header. Defaults to the SMTP mailbox — change it only if the domain's
# SPF and DKIM cover the address you use, or mail will land in spam.
ORDER_EMAIL_FROM=""
# Where customer replies go. Defaults to the SMTP mailbox.
ORDER_EMAIL_REPLY_TO=""

# Optional fallback. Used only if SMTP is unset or its send fails.
RESEND_API_KEY=""

# Optional auth throttling overrides (defaults: 15 sign-ins / 5 min,
# 20 registrations / hour, per IP). Raise these if a shared institutional IP
# legitimately trips them.
LOGIN_RATE_LIMIT=""
REGISTER_RATE_LIMIT=""
# Orders per IP per 10 minutes (default 10).
CHECKOUT_RATE_LIMIT=""

# Origin used for links in transactional email (the order payment page).
# Falls back to the Vercel deployment URL, then https://biopluslabs.co.uk.
SITE_URL=""
