# Pooled Postgres connection used by the app at runtime.
# Neon: use the -pooler host and append ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Unpooled connection used by `prisma migrate` (Neon's pooler cannot run DDL).
# For a plain Postgres server this is the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 32+ random bytes. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Vercel Blob — product images and COA uploads from the admin dashboard.
BLOB_READ_WRITE_TOKEN=""

# Outgoing mail — the shop's own mailbox (cPanel: mail.biopluslabs.co.uk,
# SMTP port 465, username customerservice@biopluslabs.co.uk). Only the password
# is required; the rest fall back to those values.
SMTP_PASSWORD=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""

# Optional alternative to SMTP. Used only when SMTP_PASSWORD is empty; with
# neither set, order emails are skipped (and logged).
RESEND_API_KEY=""

# Optional auth throttling overrides (defaults: 15 sign-ins / 5 min,
# 20 registrations / hour, per IP). Raise these if a shared institutional IP
# legitimately trips them.
LOGIN_RATE_LIMIT=""
REGISTER_RATE_LIMIT=""
# Orders per IP per 10 minutes (default 10).
CHECKOUT_RATE_LIMIT=""

# Sender address for order emails. Defaults to the SMTP mailbox, which is what
# the mail server expects to see — override only with an address that mailbox
# is allowed to send as.
ORDER_EMAIL_FROM=""
