# Pooled Postgres connection used by the app at runtime.
# Neon: use the -pooler host and append ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Unpooled connection used by `prisma migrate` (Neon's pooler cannot run DDL).
# For a plain Postgres server this is the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 32+ random bytes. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Vercel Blob — product images and COA uploads from the admin dashboard.
BLOB_READ_WRITE_TOKEN=""

# Optional. Order emails are skipped (and logged) when this is unset.
RESEND_API_KEY=""

# Optional auth throttling overrides (defaults: 15 sign-ins / 5 min,
# 20 registrations / hour, per IP). Raise these if a shared institutional IP
# legitimately trips them.
LOGIN_RATE_LIMIT=""
REGISTER_RATE_LIMIT=""
# Orders per IP per 10 minutes (default 10).
CHECKOUT_RATE_LIMIT=""

# Sender address for order emails (defaults to orders@biopluslabs.co.uk).
ORDER_EMAIL_FROM=""

# Origin used for links in transactional email (the order payment page).
# Falls back to the Vercel deployment URL, then https://biopluslabs.co.uk.
SITE_URL=""
